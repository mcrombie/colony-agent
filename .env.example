# Daily local director is free; optional OpenAI visits are off.
COLONY_AI_MODE=off
OPENAI_API_KEY=

# Daily email is enabled only after a sending account is connected.
COLONY_EMAIL_ENABLED=false
COLONY_EMAIL_TO=
SMTP_HOST=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=ssl
SMTP_PORT=465
# Optional existing published HTTPS dashboard; otherwise use attachments.
COLONY_DASHBOARD_URL=
